# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
LOG_HEALTHCHECK_REQUESTS=false

# Public URLs
PUBLIC_APP_URL=https://hatchery.auranord.net
PUBLIC_API_URL=https://hatchery.auranord.net
CORS_ORIGIN=https://hatchery.auranord.net

# Database
DATABASE_URL=postgres://erwin_hatchery:change_me@postgres:5432/erwin_hatchery
POSTGRES_DB=erwin_hatchery
POSTGRES_USER=erwin_hatchery
POSTGRES_PASSWORD=change_me

# Sessions / security
SESSION_SECRET=change_me_long_random_string
OVERLAY_SECRET=change_me_long_random_overlay_secret
ADMIN_BOOTSTRAP_ENABLED=true

# Twitch player OAuth login (still owned by Hatchery)
TWITCH_CLIENT_ID=change_me
TWITCH_CLIENT_SECRET=change_me

# Twitch channel identity / fixed gameplay tuning
TWITCH_BROADCASTER_ID=change_me
TWITCH_SUBSCRIPTION_RENEWAL_DAYS=31
TWITCH_BITS_PER_VOUCHER=500

# Deprecated direct Twitch EventSub rollback mode only.
# Leave TWITCH_EVENTSUB_SECRET empty while erwin-gateway mode is enabled.
# Set both values only when ERWIN_GATEWAY_ENABLED=false and direct EventSub
# subscription sync should be recreated by Hatchery.
TWITCH_EVENTSUB_SECRET=
TWITCH_EVENTSUB_AUTO_SYNC=false

# Incubation tuning
INCUBATION_OFFLINE_MULTIPLIER=1.0
INCUBATION_LIVE_BASE_MULTIPLIER=2.0
INCUBATION_VIEWER_MULTIPLIER_PER_VIEWER=0.01
INCUBATION_MAX_MULTIPLIER=3.0


# Debug tuning
DEBUG_MODE=false
DEBUG_EGG_RESOURCE_MULTIPLIER=1

# Pet training tuning
PET_TRAINING_MAX_LEVEL=10

# Shop tuning
SHOP_WEEKLY_EQUIPMENT_OFFER_COUNT=5
SHOP_WEEKLY_CONSUMABLE_OFFER_COUNT=5
SUBSCRIBER_SHOP_MONTHLY_OFFER_COUNT=5

# Feature flags
FEATURE_BITS_EFFECTS=true
FEATURE_SUB_INCUBATOR=true
FEATURE_CLOUDFLARE_PAGES_FRONTEND=false

# erwin-gateway foundation (enabled/observe-only by default)
# When ERWIN_GATEWAY_ENABLED=true, direct Twitch EventSub sync for migrated
# redemptions, sub/Bits, stream state, and channel updates stays disabled.
ERWIN_GATEWAY_ENABLED=true
ERWIN_GATEWAY_OBSERVE_ONLY=true
ERWIN_GATEWAY_REQUIRED=false
ERWIN_GATEWAY_AUTO_FULFILL_REDEMPTIONS=false
ERWIN_GATEWAY_URL=
ERWIN_GATEWAY_APP_API_KEY=
ERWIN_GATEWAY_WEBHOOK_SIGNING_SECRET=
ERWIN_GATEWAY_WEBHOOK_MAX_AGE_SECONDS=300
